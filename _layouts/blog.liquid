---
layout: default
---
<h1>{{ page.title }}</h1>
<ul>
  {% for post in site.posts %}
    {% assign year = post.date | date: "%Y" | plus: 0 %}
    {% if year >= 2025 %}
      <li>
        <a href="{{ post.url }}">{{ post.title }}</a> - {{ post.date | date: "%B %d, %Y" }}
      </li>
    {% endif %}
  {% endfor %}
</ul>
